# --- Redirect www verso il dominio canonico ---
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]



# --- Vecchie versioni index: 301 verso la pagina pulita ---
RewriteRule ^(.*/)?index[0-9]+\.html$ https://concessionariovelecoitalia.it/$1 [R=301,L]

# --- Vecchia versione inglese: 301 alla home ---
RewriteRule ^en(/.*)?$ https://concessionariovelecoitalia.it/ [R=301,L]
