# --- Redirect www verso il dominio canonico ---
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]



# --- Vecchie versioni index: 301 verso la pagina pulita ---
RewriteRule ^(.*/)?index[0-9]+\.html$ https://concessionariovelecoitalia.it/$1 [R=301,L]

# --- Vecchia versione inglese: 301 alla home ---
RewriteRule ^en(/.*)?$ https://concessionariovelecoitalia.it/ [R=301,L]

# --- Vecchi indirizzi visti in Analytics (pagina non trovata): 301 alla pagina giusta ---
RewriteRule ^genova/?$ https://concessionariovelecoitalia.it/#dove-siamo [R=301,L,NE]
RewriteRule ^shop/?$ https://concessionariovelecoitalia.it/modelli-veleco/ [R=301,L]
RewriteRule ^(s|home|casa|prova|err|409)/?$ https://concessionariovelecoitalia.it/ [R=301,L]

# --- Indirizzo breve da stampare (biglietti, fogli di consegna): porta alle recensioni Google della scheda ---
RewriteRule ^recensione/?$ https://g.page/r/CcP-5oF7kAJGEB0/review [R=302,L]
